# API Settings de l'application Extensions (stockage de tous les paramètres)
SETTINGS_API_URL=https://extensions-lemon.vercel.app/api/settings
# Clé déclarée dans SETTINGS_API_KEYS du projet Extensions (ne jamais l'exposer au navigateur)
SETTINGS_API_KEY=
# Facultatif : extension_id utilisé hors contexte OneStock, environnement par défaut sans api_url
EXTENSION_ID=invoice
SETTINGS_ENVIRONMENT=qualif
