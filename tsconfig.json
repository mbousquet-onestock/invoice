{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "#ds": ["./src/ds/fallback/index.ts"],
      "#lib/*": ["./lib/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "lib/**/*.js"],
  "exclude": ["src/ds/real.ts"]
}
